# Copy to .env and fill in, then: set -a; source .env; set +a
# (this project reads plain environment variables, it does not load .env by itself)

# Required for any OpenAI-backed segmentation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Optional. If set, scraped text is summarized by this Assistant (file upload + thread run).
# If empty, the summarizer falls back to a chat completion on OPENAI_MODEL.
OPENAI_SUMMARIZER_ASSISTANT_ID=

# Optional. Any endpoint that accepts the JSON payload will do; a Zoho CRM
# function URL is the original use case. Leave empty to skip the CRM export.
ZOHO_API_URL=

# Required for the Flask webhook. Requests with a mismatched Authorization header get a 401.
WEBHOOK_API_KEY=
